APP_ENV=dev
DATABASE_URL=sqlite:///./lab_ai_reviewer.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
LLM_PROVIDER=litellm
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
GITHUB_WEBHOOK_SECRET=dev-secret
ENABLE_MOCK_LLM=true
MCP_GITHUB_ENABLED=true
MCP_GITHUB_COMMAND=docker
MCP_GITHUB_ARGS_JSON=["run","-i","--rm","-e","GITHUB_PERSONAL_ACCESS_TOKEN","-e","GITHUB_TOOLSETS","-e","GITHUB_READ_ONLY","ghcr.io/github/github-mcp-server"]
MCP_GITHUB_TOOLSETS=repos,pull_requests
MCP_GITHUB_READ_ONLY=true
MCP_TIMEOUT_SECONDS=45
MCP_COMMIT_DIFF_CHAR_LIMIT=40000
MCP_COMMIT_FILE_CHAR_LIMIT=12000
